		{
			"name": "View Scoreboard Top 10",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains array of leaderboard data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"    pm.expect(jsonData.data).to.be.an(\"array\");",
							"    pm.expect(jsonData.data.length).to.be.at.most(10);",
							"});",
							"",
							"pm.test(\"First leaderboard entry has position 1\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.data.length > 0) {",
							"        pm.expect(jsonData.data[0].position).to.eql(1);",
							"        pm.expect(jsonData.data[0].score).to.be.a(\"number\");",
							"    }",
							"});"
						],
