{
	"info": {
		"_postman_id": "c1f7a0b5-7c2e-4b6f-8d2a-8d193b2a5ef1",
		"name": "Game Backend API - Modul 8",
		"description": "Postman Workspace Collection untuk pengujian Game Backend REST API (Node.js, Express.js & SQLite) mencakup Health Check, Auth Register/Login (Bcrypt & JWT), serta draft Score & Leaderboard.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is within acceptable limit (<500ms)\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"Response contains status: success\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response contains correct success message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Game Backend Server is running successfully!\");",
							"});",
							"",
							"pm.test(\"Response contains valid ISO 8601 serverTime\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.serverTime).to.be.a(\"string\");",
							"    pm.expect(isNaN(Date.parse(jsonData.serverTime))).to.be.false;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"health"
					]
				},
				"description": "Menguji status kesiapan dan kesehatan server game backend."
			},
			"response": []
		},
		{
			"name": "Register Player",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate dynamic username agar aman saat testing berulang",
							"const randomSuffix = Math.floor(Math.random() * 100000);",
							"pm.environment.set(\"testUsername\", \"player_\" + randomSuffix);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response status is success\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response returns valid userId\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.userId).to.be.a(\"number\");",
							"    pm.environment.set(\"registeredUserId\", jsonData.userId);",
							"});",
							"",
							"pm.test(\"Player profile initialized with Novice rank\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.rank).to.eql(\"Novice Planter\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"password\": \"rahasia123\",\n    \"nickname\": \"Eden Harvester\",\n    \"birthDate\": \"2002-10-15\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"register"
					]
				},
				"description": "Endpoint registrasi akun baru yang menyimpan kredensial ke tabel `users` dan membuat default `player_profiles`."
			},
			"response": []
		},
		{
			"name": "Register Player - Duplicate Username (Negative Test)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 409 Conflict\", function () {",
							"    pm.response.to.have.status(409);",
							"});",
							"",
							"pm.test(\"Response indicates username already in use\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"error\");",
							"    pm.expect(jsonData.message).to.include(\"Username sudah digunakan\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{testUsername}}\",\n    \"password\": \"rahasia123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"register"
					]
				},
