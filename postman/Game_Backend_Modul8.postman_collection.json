		{
			"name": "Update Score (POST /api/score/save)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response status is success\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response updates player highest score and stats\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.playerStats.highestScore).to.be.at.least(150);",
							"    pm.expect(jsonData.playerStats.farmsManaged).to.be.at.least(1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
