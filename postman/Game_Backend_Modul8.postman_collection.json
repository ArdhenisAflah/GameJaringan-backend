	"item": [
		{
			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is within acceptable limit (<500ms)\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"pm.test(\"Response contains status: success\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response contains correct success message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Game Backend Server is running successfully!\");",
							"});",
							"",
							"pm.test(\"Response contains valid ISO 8601 serverTime\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.serverTime).to.be.a(\"string\");",
							"    pm.expect(isNaN(Date.parse(jsonData.serverTime))).to.be.false;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"health"
					]
				},
				"description": "Menguji status kesiapan dan kesehatan server game backend."
			},
			"response": []
		},
